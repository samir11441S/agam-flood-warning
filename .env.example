# AI writes the alerts (optional — verified templates are used without any key). Tried in this order:
# Google Gemini — FREE key at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=
# Gemini models to try, first to last (Flash-Lite: fast, larger free quota; Flash: higher quality)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Groq — FREE backup when Gemini's quota runs out: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b
# Claude (paid, optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Order to try (providers without a key are skipped)
AI_PROVIDERS=gemini,groq,claude
# Telegram bot for subscribers and officer approvals (optional)
TELEGRAM_BOT_TOKEN=

# SMS: any Bangladeshi bulk-SMS gateway with an HTTP API ({to} and {message} are filled in)
SMS_API_URL=
SMS_API_METHOD=GET
# ...or Twilio SMS
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Voice calls: an IVR provider with an HTTP API that reads {message} aloud to {to}
VOICE_API_URL=
VOICE_API_METHOD=GET

# Shared secret for the incoming-SMS and call-status webhooks
INBOUND_SECRET=
# Session signing key (generated automatically into .agam-data/secret if empty)
AGAM_SECRET=
# Open-Meteo commercial API key (needed only if Agam is run as a paid service)
OPEN_METEO_API_KEY=

# Behind your own reverse proxy (nginx, Caddy…) set TRUST_PROXY=1 so wrong-PIN limits are per client address.
# Without it every client shares one limit (safe default). On Vercel the real address is used automatically.
TRUST_PROXY=
# Messages sent at once per channel when an alert goes out (default 20)
SEND_CONCURRENCY=
# Minutes without live rain data before the worker tells every officer (default 30)
OUTAGE_ALERT_MIN=
# Most AI calls per hour across providers — keeps within free quotas and guards public demos (default 40)
AI_CALLS_PER_HOUR=
